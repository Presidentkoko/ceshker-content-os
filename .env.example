# --- Required ---
DATABASE_URL=postgres://postgres:devpass@localhost:55432/contentos
# Separate schema so n8n's own tables are never touched
DB_SCHEMA=content_os
# 32+ random chars; used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Bootstrap administrator, created by `npm run seed` only when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Planning source (Google Sheet must be viewable by link, or use a service account) ---
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_GID=0
APP_TIMEZONE=America/Chicago

# --- n8n (optional until configured) ---
# Base URL of the n8n service, used for health checks, e.g. https://n8n-production.up.railway.app
N8N_BASE_URL=
# Webhook that receives dry-run / publish jobs from the dashboard
N8N_PUBLISH_WEBHOOK_URL=
# Shared secret: dashboard signs webhook bodies with HMAC-SHA256 (X-ContentOS-Signature)
N8N_WEBHOOK_SECRET=
# Secret n8n must send in X-ContentOS-Callback-Secret when reporting publish results
N8N_CALLBACK_SECRET=

# --- Integrations (leave empty until access is granted) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
NFAMATION_DRIVE_FOLDER_ID=your-drive-folder-id
META_PAGE_ID=
META_IG_USER_ID=
META_SYSTEM_USER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Canva Connect integration (Developer Portal); redirect URL: <PUBLIC_URL>/api/oauth/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

PORT=8080
